@page "/player/join"
@layout PlayerLayout
@using QuizRoom.Web.Services
@inject NavigationManager Navigation
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Подключение к игре — QuizRoom</PageTitle>

@if (!isConnectionAvailable)
{
    <div class="connection-warning">
        Соединение потеряно. Ожидаем восстановления...
    </div>
}

<div class="join-page">
    @if (!isJoined)
    {
        <section class="join-card">
            <div class="join-heading">
                <span class="join-subtitle">QUIZROOM</span>
                <h1>Подключение к игре</h1>
                <p>Введи код комнаты и своё имя, чтобы присоединиться к викторине</p>
            </div>

            <div class="join-form">
                <div class="form-group">
                    <label for="roomCode">Код комнаты</label>
                    <input id="roomCode"
                           type="text"
                           inputmode="numeric"
                           maxlength="10"
                           placeholder="Например, 123456"
                           @bind="roomCode"
                           @bind:event="oninput"
                           disabled="@isConnecting" />
                </div>

                <div class="form-group">
                    <label for="nickname">Твой ник</label>
                    <input id="nickname"
                           type="text"
                           maxlength="20"
                           placeholder="Как тебя называть?"
                           @bind="nickname"
                           @bind:event="oninput"
                           disabled="@isConnecting" />
                    <span class="field-hint">От 2 до 20 символов</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="join-error" role="alert">
                        @errorMessage
                    </div>
                }

                <button class="join-button"
                        @onclick="JoinGame"
                        disabled="@isConnecting">
                    @(isConnecting ? "Подключение..." : "Присоединиться")
                </button>
            </div>

            <div class="join-footer">
                Готов? Тогда начинаем!
            </div>
        </section>
    }
    else
    {
        <section class="waiting-card">
            <div class="waiting-indicator">
                <span></span>
                <span></span>
                <span></span>
            </div>

            <span class="join-subtitle">QUIZROOM</span>
            <h1>Ждём начала игры</h1>
            <p>Ты успешно подключился к комнате.</p>

            <div class="waiting-player">
                <span class="player-avatar">@nicknameInitial</span>
                <div>
                    <strong>@nickname</strong>
                    <span>Участник игры</span>
                </div>
            </div>

            <div class="room-code-display">
                <span>Код комнаты</span>
                <strong>@roomCode</strong>
            </div>

            <p class="waiting-hint">
                Участников в комнате: @totalPlayers
            </p>

            <p class="waiting-hint">
                Ожидай, пока ведущий начнёт викторину
            </p>
        </section>
    }
</div>

@code {
    private IGameConnection GameConnection => FakeGameConnection.Shared;
    private string roomCode = "";
    private string nickname = "";
    private string? errorMessage;

    private bool isJoined;
    private bool isConnecting;

    private bool isConnectionAvailable = true;
    private int totalPlayers = 0;

    protected override void OnInitialized()
    {
        GameConnection.PlayerJoined += OnPlayerJoined;
        GameConnection.ConnectionStateChanged += OnConnectionStateChanged;
        GameConnection.QuestionStarted += OnQuestionStarted;
    }

    private void OnConnectionStateChanged(bool connected)
    {
        _ = InvokeAsync(() =>
        {
            isConnectionAvailable = connected;
            StateHasChanged();
        });
    }

    private void OnPlayerJoined(string nick, int count)
    {
        _ = InvokeAsync(() =>
        {
            totalPlayers = count;
            StateHasChanged();
        });
    }

    private void OnQuestionStarted(QuizRoom.Contracts.QuestionForPlayerDto question)
    {
        _ = InvokeAsync(() =>
        {
            Navigation.NavigateTo("/player/question");
        });
    }

    public void Dispose()
    {
        GameConnection.PlayerJoined -= OnPlayerJoined;
        GameConnection.ConnectionStateChanged -= OnConnectionStateChanged;
        GameConnection.QuestionStarted -= OnQuestionStarted;
    }

    private string nicknameInitial =>
        string.IsNullOrWhiteSpace(nickname)
            ? "?"
            : nickname.Trim()[0].ToString().ToUpper();

    // Восстанавливаем данные игрока из sessionStorage.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            roomCode = await JSRuntime.InvokeAsync<string>(
                "sessionStorage.getItem", "roomCode") ?? "";

            nickname = await JSRuntime.InvokeAsync<string>(
                "sessionStorage.getItem", "nickname") ?? "";

            if (!string.IsNullOrWhiteSpace(roomCode) &&
                !string.IsNullOrWhiteSpace(nickname))
            {
                FakeGameConnection.Shared.RestorePlayerSession(roomCode, nickname);
            }

            StateHasChanged();
        }
    }

    // Подключение игрока к игровой комнате
    private async Task JoinGame()
    {
        if (isConnecting)
            return;

        errorMessage = null;

        roomCode = roomCode.Trim();
        nickname = nickname.Trim();

        if (string.IsNullOrWhiteSpace(roomCode) ||
            !roomCode.All(char.IsDigit))
        {
            errorMessage = "Введи корректный числовой код комнаты";
            return;
        }

        if (nickname.Length < 2 || nickname.Length > 20)
        {
            errorMessage = "Ник должен содержать от 2 до 20 символов";
            return;
        }

        isConnecting = true;

        try
        {
            var result = await GameConnection.JoinRoomAsync(
                roomCode, nickname);

            if (!result.Success)
            {
                errorMessage = result.Error ?? "Не удалось подключиться к комнате";
                return;
            }

            isJoined = true;

            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "roomCode", roomCode);
            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "nickname", nickname);

        }
        catch (Exception)
        {
            errorMessage = "Не удалось связаться с игровым сервером. Попробуй ещё раз.";
        }
        finally
        {
            isConnecting = false;
        }
    }
}
