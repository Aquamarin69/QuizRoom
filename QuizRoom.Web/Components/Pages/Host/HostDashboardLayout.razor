@inherits LayoutComponentBase
@using QuizRoom.Contracts
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="host-shell">
    <header class="host-topbar">
        <a href="/host/quizzes" class="brand-link">
            <span class="brand-icon" aria-hidden="true">🎓</span>
            <span class="brand-word"><span class="brand-dark">Quiz</span><span class="brand-accent">Room</span></span>
        </a>

        @if (AuthService.CurrentHostId is not null)
        {
            <div class="host-profile">
                <div class="host-avatar" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </div>
                <span class="host-name">Ведущий #@AuthService.CurrentHostId</span>
            </div>
        }
    </header>

    <div class="host-body">
        <aside class="host-sidebar">
            <nav class="sidebar-nav" aria-label="Меню ведущего">
                <a href="/host/quizzes"
                   class="nav-pill @(IsActive("/host/quizzes") ? "active" : "")">
                    Мои викторины
                </a>

                <a href="/host/quizzes?create=1"
                   class="nav-pill @(IsActiveCreate() ? "active" : "")">
                    + Создать викторину
                </a>

                <button type="button"
                        class="nav-pill nav-logout"
                        @onclick="LogoutAsync">
                    Выход
                </button>
            </nav>
        </aside>

        <main class="host-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool IsActive(string path)
    {
        var uri = Navigation.Uri;
        return uri.EndsWith(path, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsActiveCreate()
    {
        return Navigation.Uri.Contains("create=1", StringComparison.OrdinalIgnoreCase);
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/host/auth");
    }
}