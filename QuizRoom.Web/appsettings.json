{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // true  - сервисы-заглушки из папки Fakes (фронтенд работает без БД)
  // false - реальные сервисы (когда бэкенд готов)
  "UseFakes": true,

  // Шаблон. Реальные значения кладём в appsettings.Local.json (он в .gitignore).
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=quizroom;User=quizroom;Password=CHANGE_ME;"
  }
}
